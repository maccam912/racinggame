; Pacific Rush — see DESIGN.md for the normative contract.
config_version=5

[application]
config/name="Pacific Rush"
config/version="0.0.1-dev"
run/max_fps=60
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/exported/icon.svg"
config/quit_on_go_back=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.396, 0.725, 0.922, 1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
3d/physics_engine="GodotPhysics3D"

[audio]
driver/enable_input=false

