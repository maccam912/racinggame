# Fill with this release's metadata and operator-owned infrastructure.
# Keep actual keys in the persistent data volume, never in this file or image.
PR_SERVER_IMAGE=ghcr.io/maccam912/pacific-rush-server@sha256:RELEASE_IMAGE_DIGEST
PR_PUBLIC_ADDRESS=https://YOUR_REGION_DOMAIN
PR_WORKER_HOST=YOUR_WORKER_HOST
PR_REGION_ID=YOUR_REGION_ID
PR_REGION_NAME=YOUR_REGION_NAME
PR_PROTOCOL=PROTOCOL_FROM_BUILD_JSON
PR_CONTENT_HASH=HASH_FROM_BUILD_JSON
PR_WORKERS=MEASURED_POOL_CAP
PR_HOST_WORKERS=MEASURED_HOST_CAP
PR_DATA_VOLUME=pacific-YOUR_REGION-data
PR_LOG_VOLUME=pacific-YOUR_REGION-logs
PR_POOL_ID=pool-a
PR_HTTP_PORT=8080
PR_PRIVATE_PORT=8081
PR_FIRST_PORT=27020
