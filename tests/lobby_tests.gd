extends SceneTree


func _initialize() -> void:
	var lobby := LobbyState.new()
	assert(not lobby.join("z", "Driver A", 10).is_empty())
	assert(not lobby.join("b", "Driver B", 20).is_empty())
	assert(not lobby.join("a", "Driver C", 20).is_empty())
	assert(lobby.host_id == "z")
	lobby.set_ready("z", true)
	lobby.set_ready("b", true)
	assert(lobby.step(30) == "" and lobby.countdown_tick == 1230)
	lobby.set_ready("a", true)
	lobby.step(40)
	assert(lobby.countdown_tick == 340)
	lobby.select_car("b", 2, 3)
	assert(not lobby.member("b").ready and lobby.member("a").ready)
	lobby.step(50)
	assert(lobby.countdown_tick == 1250)
	assert(not lobby.set_rules("a", lobby.rules))
	var rules := lobby.rules.duplicate()
	rules.track = 7
	rules.difficulty = 3
	assert(LobbyState.valid_rules(rules))
	var invalid := rules.duplicate()
	invalid.difficulty = 4
	assert(not LobbyState.valid_rules(invalid))
	assert(lobby.set_rules("z", rules))
	assert(lobby.members.all(func(row: Dictionary) -> bool: return not row.ready))
	assert(lobby.kick("z", "b", 60))
	assert(lobby.join("b", "Driver B", 35999).is_empty())
	assert(lobby.leave("z") and lobby.host_id == "a")
	lobby.set_ready("a", true)
	assert(lobby.request_start("a", 100))
	assert(lobby.join("x", "Driver X", 101).is_empty())
	assert(not lobby.kick("a", "x", 101))
	assert(lobby.roster().size() == 8)
	lobby.member("a").loaded = true
	assert(lobby.step(101) == "start")
	lobby.finish(1000)
	assert(lobby.step(2199) == "")
	assert(lobby.step(2200) == "lobby" and not lobby.member("a").ready)
	assert(not lobby.join("b", "Driver B", 36100).is_empty())
	lobby.set_ready("a", true)
	lobby.set_ready("b", true)
	lobby.request_start("a", 40000)
	lobby.member("a").loaded = true
	assert(lobby.step(41800) == "start" and lobby.excluded == ["Driver B"])
	assert(lobby.members.size() == 1 and lobby.roster().size() == 8)
	var encoder := ReliableFragments.new()
	var decoder := ReliableFragments.new()
	var text := "PRJS" + JSON.stringify({"type":"lobby", "names":"👨‍👩‍👧‍👦".repeat(200)})
	var bytes := text.to_utf8_buffer()
	var parts := encoder.split(bytes)
	assert(parts.size() > 1)
	var result := PackedByteArray()
	parts.reverse()
	for part: PackedByteArray in parts:
		assert(part.size() <= 1200)
		result = decoder.receive(1, part, 100)
	assert(result == bytes)
	assert(decoder.receive(1, parts[0].slice(0, 12), 100).is_empty())
	var partial := ReliableFragments.new()
	partial.receive(1, parts[0], 100)
	for part: PackedByteArray in parts.slice(1):
		assert(partial.receive(2, part, 100).is_empty())
	assert(partial.receive(1, parts[1], 6000).is_empty())
	print("Lobby contracts: ready timers, host, car/rules reset, bans, loading timeout, rematch and bounded/source-isolated fragments pass")
	quit()
