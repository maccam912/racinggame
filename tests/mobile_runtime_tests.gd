extends SceneTree
func _initialize() -> void: call_deferred("run")
func samples(policy: AdaptiveResolution, count: int, work: float, interval: float) -> void:
	for index in range(count): policy.sample(work,interval,true)
func run() -> void:
	var policy := AdaptiveResolution.new()
	policy.configure(80,true,60)
	samples(policy,99,.02,.02)
	assert(policy.current==80)
	assert(policy.sample(.02,.02,true) and policy.current==70,"two continuous seconds lower exactly ten points")
	samples(policy,100,.02,.02)
	assert(policy.current==60)
	samples(policy,100,.03,.03)
	assert(policy.current==60,"adaptive floor stays at sixty")
	samples(policy,599,.01,1.0/60)
	assert(policy.current==60)
	assert(policy.sample(.01,1.0/60,true) and policy.current==70,"ten seconds of unthrottled headroom restores one step despite a 60 FPS cap")
	samples(policy,600,.01,1.0/60)
	assert(policy.current==80)
	samples(policy,600,.01,1.0/60)
	assert(policy.current==80)
	policy.current = 60
	samples(policy,300,.01,1.0/60)
	policy.sample(.01,1.0/60,false)
	samples(policy,300,.01,1.0/60)
	assert(policy.current==60,"menus/pause break the consecutive measurement window")
	policy.sample(NAN,.02,true)
	assert(policy.fast_seconds==0 and policy.slow_seconds==0)
	policy.sample(.01,2.0,true)
	assert(policy.fast_seconds==0,"an OS gap cannot count as render pressure")
	samples(policy,120,.01,.02)
	assert(policy.current==60,"missed presentation deadlines supplement absent GLES GPU timers")
	policy.configure(50,true,30)
	samples(policy,100,.05,.05)
	assert(policy.current==50,"an explicitly selected lower scale is never raised to the adaptive floor")
	policy.configure(80,false,60)
	assert(policy.current==80 and not policy.sample(.1,.1,true))
	policy.configure(80,true,30)
	samples(policy,49,.04,.04)
	assert(policy.current==80)
	policy.sample(.04,.04,true)
	assert(policy.current==70)
	policy.configure(80,true,30)
	assert(policy.current==70,"unchanged settings reapplication retains current quality")
	var app: Node = load("res://game/client_app.gd").new()
	root.add_child(app)
	await process_frame
	var folder := "user://tests/mobile-runtime-"+RaceSetup.uuid()
	app.data = AppData.new(folder,true)
	app.data.profile.first_run_complete = true
	app.show_menu()
	app.mobile_runtime.refresh()
	assert(not app.mobile_runtime.awake)
	var old_menu: Control = app.menu.root
	var old_icon: Texture2D = UIIcons.texture("menu_quick")
	assert(not UIIcons.textures.is_empty() and is_instance_valid(app.stage))
	app.notification(MainLoop.NOTIFICATION_OS_MEMORY_WARNING)
	assert(app.stage==null and app.menu.root==old_menu and UIIcons.texture("menu_quick")==old_icon,"active canvas icon resources remain owned after a memory notification")
	await process_frame
	app.show_garage()
	assert(is_instance_valid(app.stage),"next preview action rebuilds after memory pressure")
	app.request_drive({"mode":"quick","track":0,"opponents":2},app.show_menu)
	app.mobile_runtime.refresh()
	assert(app.page=="loading" and app.mobile_runtime.awake)
	var loader: TrackLoader = app.track_loader
	app.notification(MainLoop.NOTIFICATION_OS_MEMORY_WARNING)
	assert(app.track_loader==loader and not loader.cancelled,"memory pressure preserves the current loading job")
	while app.page=="loading": await process_frame
	app.drive.set_physics_process(false)
	app.mobile_runtime.refresh()
	assert(app.mobile_runtime.awake)
	var display: WorldPresentation = app.presentation
	display.pixel_size_override = Vector2i(1920,1080)
	SettingsRuntime.apply(app,app.data.settings)
	assert(display.adaptive.enabled and display.viewport.size==Vector2i(1536,864))
	var host_size := root.get_visible_rect().size
	var hud_scale: float = app.drive.hud.ui_scale
	var physics_space: RID = app.drive.world.get_world_3d().space
	var position: Vector3 = app.drive.state.position
	var uuid: String = app.drive.session.race_uuid
	var selected: Dictionary = app.data.settings.duplicate(true)
	display.adaptive.current = 60
	display.reflow()
	assert(display.viewport.size==Vector2i(1152,648) and root.get_visible_rect().size==host_size and app.drive.hud.ui_scale==hud_scale)
	assert(display.viewport.msaa_3d==Viewport.MSAA_2X and app.data.settings==selected,"adaptive changes neither AA/effects nor persisted settings")
	var foliage := app.drive.world.find_child("IllustratedBillboard_palm",true,false) as MultiMeshInstance3D
	assert(foliage!=null and not BillboardArt.materials.is_empty())
	var retained_foliage: Material = foliage.material_override
	app.notification(MainLoop.NOTIFICATION_OS_MEMORY_WARNING)
	await physics_frame
	assert(BillboardArt.materials.is_empty() and BillboardArt.cards.is_empty(),"memory pressure releases reusable billboard references")
	assert(foliage.material_override==retained_foliage and (retained_foliage as StandardMaterial3D).albedo_texture!=null,"active foliage keeps its live material and texture")
	assert(app.drive.world.get_world_3d().space==physics_space and app.drive.state.position==position and app.drive.session.race_uuid==uuid)
	assert(app.drive.session.queries.size()==3 and not Catalog.tracks.is_empty() and not Catalog.cars.is_empty(),"active collision, queries, vehicle state and mandatory content survive")
	app.drive.show_pause()
	app.mobile_runtime.refresh()
	assert(not app.mobile_runtime.awake)
	app.resume_drive()
	app.mobile_runtime.refresh()
	assert(app.mobile_runtime.awake)
	app.handle_background()
	assert(not app.mobile_runtime.awake)
	display._process(0)
	assert(display.viewport.render_target_update_mode==SubViewport.UPDATE_DISABLED)
	app.notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	display._process(0)
	assert(display.viewport.render_target_update_mode==SubViewport.UPDATE_ALWAYS and not display.adaptive_active())
	app.show_menu()
	app.mobile_runtime.refresh()
	assert(not app.mobile_runtime.awake and app.data.profile.races_completed==0)
	app.queue_free()
	await create_timer(.5).timeout
	assert(AppData.remove_tree(ProjectSettings.globalize_path(folder))==OK)
	print("MOBILE_KEEP_AWAKE_FOREGROUND_LOADING_PLAY_ONLY_ADAPTIVE_2_10_SECONDS_60_FLOOR_NATIVE_HUD_MEMORY_ACTIVE_COLLISION_PRESERVED_PASS")
	quit()
